# Route recognizably destructive command families through the separate automatic
# reviewer. These rules prompt the reviewer, not necessarily the user.

prefix_rule(
    pattern = ["rm", ["-r", "-R", "-rf", "-rF", "-fr", "-fR", "-Rf", "-RF", "--recursive"]],
    decision = "prompt",
    justification = "Recursive deletion requires an independent scope and recoverability review",
    match = ["rm -rf build", "rm --recursive generated"],
    not_match = ["rm /tmp/one-file", "rmdir empty-directory"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset can discard commits or uncommitted work",
    match = ["git reset --hard HEAD~1", "git reset --hard origin/main"],
    not_match = ["git reset HEAD file.txt", "git status"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fx", "-xf", "-fdx", "-xdf"]],
    decision = "prompt",
    justification = "Git clean permanently removes untracked files",
    match = ["git clean -fd", "git clean -xdf"],
    not_match = ["git clean -n", "git clean --dry-run"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease", "--delete"]],
    decision = "prompt",
    justification = "Force pushes and remote ref deletion can destroy shared history",
    match = ["git push --force origin feature", "git push --force-with-lease origin feature", "git push --delete origin old-branch"],
    not_match = ["git push origin main", "git fetch origin"],
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "prompt",
    justification = "Repository deletion is externally visible and difficult to recover",
    match = ["gh repo delete owner/repo"],
    not_match = ["gh repo view owner/repo"],
)

prefix_rule(
    pattern = ["terraform", "destroy"],
    decision = "prompt",
    justification = "Infrastructure destruction requires an independent target review",
    match = ["terraform destroy", "terraform destroy -auto-approve"],
    not_match = ["terraform plan", "terraform apply"],
)

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "prompt",
    justification = "Cluster resource deletion requires an independent target review",
    match = ["kubectl delete deployment api", "kubectl delete namespace staging"],
    not_match = ["kubectl get pods", "kubectl describe deployment api"],
)
